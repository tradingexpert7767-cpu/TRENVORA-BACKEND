generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

// ---------------------------------------------------------------------------
// Phase 0/2: identity foundation. Trading, journal, DNA, replay, strategy and
// options tables are added incrementally in their owning phase rather than
// modeled speculatively here.
// ---------------------------------------------------------------------------

enum SubscriptionTier {
  FREE
  PRO
  PRO_PLUS
}

enum RiskPreference {
  CONSERVATIVE
  MODERATE
  AGGRESSIVE
}

enum TradeInstrument {
  NIFTY
  BANK_NIFTY
  SENSEX
}

enum InstrumentType {
  SPOT
  OPTION
}

enum TradeSide {
  BUY
  SELL
}

enum TradeEmotion {
  Calm
  Confident
  Fearful
  FOMO
  Revenge
  Uncertain
}

enum OptionType {
  CE
  PE
}

enum TradeStatus {
  OPEN
  CLOSED
}

model User {
  id            String   @id @default(uuid()) @db.Uuid
  email         String   @unique
  name          String?
  passwordHash  String?  @map("password_hash")
  googleId      String?  @unique @map("google_id")
  emailVerified Boolean  @default(false) @map("email_verified")
  createdAt     DateTime @default(now()) @map("created_at")
  updatedAt     DateTime @updatedAt @map("updated_at")

  profile      Profile?
  auditLogs    AuditLog[]
  otpCodes     OtpCode[]
  paperTrades  PaperTrade[]

  @@map("users")
}

model OtpCode {
  id        String   @id @default(uuid()) @db.Uuid
  userId    String   @map("user_id") @db.Uuid
  code      String
  purpose   String   // "email_verification" | "password_reset"
  expiresAt DateTime @map("expires_at")
  usedAt    DateTime? @map("used_at")
  createdAt DateTime @default(now()) @map("created_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("otp_codes")
}

model PaperTrade {
  id             String          @id @default(uuid()) @db.Uuid
  userId         String          @map("user_id") @db.Uuid
  instrument     TradeInstrument
  instrumentType InstrumentType  @map("instrument_type")
  side           TradeSide
  status         TradeStatus     @default(OPEN)
  quantity       Int
  entryPrice     Decimal         @map("entry_price") @db.Decimal(12, 2)
  exitPrice      Decimal?        @map("exit_price") @db.Decimal(12, 2)
  stopLoss       Decimal?        @map("stop_loss") @db.Decimal(12, 2)
  target         Decimal?        @db.Decimal(12, 2)
  pnl            Decimal?        @db.Decimal(12, 2)
  thesis         String?
  emotion        TradeEmotion?
  optionType     OptionType?     @map("option_type")
  strike         Decimal?        @db.Decimal(10, 2)
  expiry         String?
  openedAt       DateTime        @default(now()) @map("opened_at")
  closedAt       DateTime?       @map("closed_at")
  createdAt      DateTime        @default(now()) @map("created_at")
  updatedAt      DateTime        @updatedAt @map("updated_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([userId, status])
  @@map("paper_trades")
}

model Profile {
  id                  String          @id @default(uuid()) @db.Uuid
  userId              String          @unique @map("user_id") @db.Uuid
  displayName         String?         @map("display_name")
  tradingExperience    String?         @map("trading_experience")
  preferredInstruments String[]        @map("preferred_instruments")
  riskPreference       RiskPreference? @map("risk_preference")
  onboardingCompletedAt DateTime?      @map("onboarding_completed_at")
  subscriptionTier     SubscriptionTier @default(FREE) @map("subscription_tier")
  createdAt            DateTime        @default(now()) @map("created_at")
  updatedAt            DateTime        @updatedAt @map("updated_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("profiles")
}

model AuditLog {
  id        String   @id @default(uuid()) @db.Uuid
  userId    String?  @map("user_id") @db.Uuid
  action    String
  metadata  Json?
  createdAt DateTime @default(now()) @map("created_at")

  user User? @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([userId])
  @@map("audit_logs")
}
